{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://napoleon-it.local/schemas/session-agent-output-v1.json",
  "title": "Session-scoped interview agent outputs",
  "oneOf": [
    {"$ref": "#/$defs/resume_relevance"},
    {"$ref": "#/$defs/question_plan"},
    {"$ref": "#/$defs/answer_assessment"},
    {"$ref": "#/$defs/alternative_vacancy_match"},
    {"$ref": "#/$defs/integrity_check"}
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["schema_version", "purpose"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v1"},
        "purpose": {
          "enum": [
            "resume_relevance",
            "question_plan",
            "answer_assessment",
            "alternative_vacancy_match",
            "integrity_check"
          ]
        }
      }
    },
    "resume_relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "positions", "claims", "experience_matches", "gaps"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v1"},
        "purpose": {"const": "resume_relevance"},
        "positions": {"type": "array", "items": {"$ref": "#/$defs/resume_position"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/resume_claim"}},
        "experience_matches": {"type": "array", "items": {"$ref": "#/$defs/experience_match"}},
        "gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resume_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_id", "employer", "role", "period", "project", "responsibilities", "skills", "achievements", "source_excerpt"],
      "properties": {
        "position_id": {"type": "string", "minLength": 1},
        "employer": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "period": {"type": ["string", "null"]},
        "project": {"type": ["string", "null"]},
        "responsibilities": {"type": "array", "items": {"type": "string"}},
        "skills": {"type": "array", "items": {"type": "string"}},
        "achievements": {"type": "array", "items": {"type": "string"}},
        "source_excerpt": {"type": "string", "minLength": 1}
      }
    },
    "resume_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "subject", "source_excerpt", "verification_status"],
      "properties": {
        "claim_id": {"type": "string"},
        "claim_type": {"enum": ["experience", "skill", "achievement", "responsibility", "level_signal"]},
        "subject": {"type": "string", "minLength": 1},
        "source_excerpt": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["unverified", "supported", "contradicted", "insufficient_information"]}
      }
    },
    "experience_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experience_label", "source_excerpt", "requirement", "requirement_origin", "relevance", "confidence", "explanation", "position_ids", "claim_ids"],
      "properties": {
        "experience_label": {"type": "string", "minLength": 1},
        "source_excerpt": {"type": "string", "minLength": 1},
        "requirement": {"type": "string", "minLength": 1},
        "requirement_origin": {"enum": ["vacancy", "manager_brief"]},
        "relevance": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "explanation": {"type": "string", "minLength": 1},
        "position_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "title", "dimension", "weight"],
      "properties": {
        "criterion_id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "dimension": {"enum": ["technical", "soft_skills", "corporate_competencies", "vacancy_fit", "leadership"]},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "positive_signals": {"type": "array", "items": {"type": "string"}},
        "negative_signals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "question_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "questions"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v1"},
        "purpose": {"const": "question_plan"},
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question_id", "prompt", "kind", "criteria", "source_claim_ids", "source_manager_field_keys", "selection_reason"],
            "properties": {
              "question_id": {"type": "string", "format": "uuid"},
              "prompt": {"type": "string", "minLength": 1},
              "kind": {"enum": ["baseline", "personalized"]},
              "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
              "source_claim_ids": {"type": "array", "items": {"type": "string"}},
              "source_manager_field_keys": {"type": "array", "items": {"type": "string"}},
              "selection_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "excerpt"],
      "properties": {
        "kind": {"enum": ["supporting", "counter", "mixed", "information_gap"]},
        "excerpt": {"type": ["string", "null"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "dimension", "label", "value", "confidence", "explanation", "evidence"],
      "properties": {
        "criterion_id": {"type": "string"},
        "dimension": {"enum": ["technical", "soft_skills", "corporate_competencies", "vacancy_fit", "leadership"]},
        "label": {"enum": ["contradicted", "weak", "neutral", "supported", "strong", "insufficient_information"]},
        "value": {"type": ["number", "null"], "enum": [-1, -0.5, 0, 0.5, 1, null]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "explanation": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "answer_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "response_id", "question_id", "observations"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v1"},
        "purpose": {"const": "answer_assessment"},
        "response_id": {"type": "string", "format": "uuid"},
        "question_id": {"type": "string", "format": "uuid"},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
      }
    },
    "alternative_vacancy_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "target_vacancy_id", "candidate_grade", "target_grade", "compatibility_status", "fit_value", "matched_criteria", "matched_terms", "gaps", "evidence_references", "explanation"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v1"},
        "purpose": {"const": "alternative_vacancy_match"},
        "target_vacancy_id": {"type": "string", "format": "uuid"},
        "candidate_grade": {"enum": ["unknown", "intern", "junior", "middle", "senior", "lead"]},
        "target_grade": {"enum": ["unknown", "intern", "junior", "middle", "senior", "lead"]},
        "compatibility_status": {"enum": ["compatible", "manual_comparison_required"]},
        "fit_value": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "matched_criteria": {"type": "array", "items": {"type": "string"}},
        "matched_terms": {"type": "array", "items": {"type": "string"}},
        "gaps": {"type": "array", "items": {"type": "string"}},
        "evidence_references": {"type": "array", "items": {"type": "string"}},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "integrity_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "observations", "is_restriction"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v1"},
        "purpose": {"const": "integrity_check"},
        "is_restriction": {"const": false},
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "resume_excerpt", "answer_excerpt", "response_id", "explanation", "clarification_question", "confidence"],
            "properties": {
              "status": {"enum": ["consistent", "unverified_claim", "contradiction_detected", "manual_integrity_review"]},
              "resume_excerpt": {"type": ["string", "null"]},
              "answer_excerpt": {"type": ["string", "null"]},
              "response_id": {"type": ["string", "null"], "format": "uuid"},
              "explanation": {"type": "string", "minLength": 1},
              "clarification_question": {"type": ["string", "null"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  }
}
