{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://napoleon-it.local/schemas/session-agent-output-v2.json",
  "title": "Session-scoped interview agent outputs",
  "oneOf": [
    {"$ref": "#/$defs/resume_relevance"},
    {"$ref": "#/$defs/question_plan"},
    {"$ref": "#/$defs/answer_assessment"},
    {"$ref": "#/$defs/alternative_vacancy_match"},
    {"$ref": "#/$defs/integrity_check"},
    {"$ref": "#/$defs/candidate_feedback"}
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["schema_version", "purpose"],
      "properties": {
        "schema_version": {"enum": ["session_agent_output_v2", "candidate_feedback_v1"]},
        "purpose": {
          "enum": [
            "resume_relevance",
            "question_plan",
            "answer_assessment",
            "alternative_vacancy_match",
            "integrity_check",
            "candidate_feedback"
          ]
        }
      }
    },
    "resume_relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "positions", "claims", "experience_matches", "gaps"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v2"},
        "purpose": {"const": "resume_relevance"},
        "positions": {"type": "array", "items": {"$ref": "#/$defs/resume_position"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/resume_claim"}},
        "experience_matches": {"type": "array", "items": {"$ref": "#/$defs/experience_match"}},
        "gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resume_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_id", "employer", "role", "period", "project", "responsibilities", "skills", "achievements", "evidence_ids"],
      "properties": {
        "position_id": {"type": "string", "minLength": 1},
        "employer": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "period": {"type": ["string", "null"]},
        "project": {"type": ["string", "null"]},
        "responsibilities": {"type": "array", "items": {"type": "string"}},
        "skills": {"type": "array", "items": {"type": "string"}},
        "achievements": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "resume_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "subject", "evidence_ids", "verification_status"],
      "properties": {
        "claim_id": {"type": "string"},
        "claim_type": {"enum": ["experience", "skill", "achievement", "responsibility", "level_signal"]},
        "subject": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "verification_status": {"enum": ["unverified", "supported", "contradicted", "insufficient_information"]}
      }
    },
    "experience_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experience_label", "evidence_ids", "requirement_id", "requirement_origin", "relevance", "confidence", "explanation", "position_ids", "claim_ids"],
      "properties": {
        "experience_label": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requirement_id": {"type": "string", "minLength": 1},
        "requirement_origin": {"enum": ["vacancy", "manager_brief"]},
        "relevance": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "explanation": {"type": "string", "minLength": 1},
        "position_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "title", "dimension", "weight"],
      "properties": {
        "criterion_id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "dimension": {"enum": ["technical", "soft_skills", "corporate_competencies", "vacancy_fit", "leadership"]},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "positive_signals": {"type": "array", "items": {"type": "string"}},
        "negative_signals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "question_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "questions"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v2"},
        "purpose": {"const": "question_plan"},
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question_id", "prompt", "kind", "criteria", "source_claim_ids", "source_manager_field_keys", "selection_reason"],
            "properties": {
              "question_id": {"type": "string", "format": "uuid"},
              "prompt": {"type": "string", "minLength": 1},
              "kind": {"enum": ["baseline", "personalized", "follow_up", "live_coding"]},
              "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
              "source_claim_ids": {"type": "array", "items": {"type": "string"}},
              "source_manager_field_keys": {"type": "array", "items": {"type": "string"}},
              "selection_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence_id"],
      "properties": {
        "kind": {"enum": ["supporting", "counter", "mixed", "information_gap"]},
        "evidence_id": {"type": ["string", "null"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "dimension", "label", "value", "confidence", "explanation", "evidence"],
      "properties": {
        "criterion_id": {"type": "string"},
        "dimension": {"enum": ["technical", "soft_skills", "corporate_competencies", "vacancy_fit", "leadership"]},
        "label": {"enum": ["contradicted", "weak", "neutral", "supported", "strong", "insufficient_information"]},
        "value": {"type": ["number", "null"], "enum": [-1, -0.5, 0, 0.5, 1, null]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "explanation": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "answer_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "response_id", "question_id", "observations", "follow_up", "live_coding"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v2"},
        "purpose": {"const": "answer_assessment"},
        "response_id": {"type": "string", "format": "uuid"},
        "question_id": {"type": "string", "format": "uuid"},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
        "follow_up": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["trigger", "prompt", "reason", "criterion_ids", "requirement_ids", "resume_claim_ids"],
                "properties": {
                  "trigger": {"enum": ["low_confidence", "missing_detail"]},
                  "prompt": {"type": "string", "minLength": 1, "pattern": "^[^?]*\\?[^?]*$"},
                  "reason": {"type": "string", "minLength": 1},
                  "criterion_ids": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
                  "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
                  "resume_claim_ids": {"type": "array", "maxItems": 4, "items": {"type": "string"}}
                }
              }
            }
          ]
        },
        "live_coding": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["trigger", "prompt", "reason", "criterion_ids", "requirement_ids", "resume_claim_ids"],
              "properties": {
                "trigger": {"const": "claimed_technical_skill_not_demonstrated"},
                "prompt": {"type": "string", "minLength": 1, "maxLength": 2000},
                "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
                "criterion_ids": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
                "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
                "resume_claim_ids": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}}
              }
            }
          ]
        }
      }
    },
    "alternative_vacancy_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "target_vacancy_id", "candidate_grade", "target_grade", "compatibility_status", "fit_value", "matched_criteria", "matched_terms", "gaps", "evidence_references", "explanation"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v2"},
        "purpose": {"const": "alternative_vacancy_match"},
        "target_vacancy_id": {"type": "string", "format": "uuid"},
        "candidate_grade": {"enum": ["unknown", "intern", "junior", "middle", "senior", "lead"]},
        "target_grade": {"enum": ["unknown", "intern", "junior", "middle", "senior", "lead"]},
        "compatibility_status": {"enum": ["compatible", "manual_comparison_required"]},
        "fit_value": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "matched_criteria": {"type": "array", "items": {"type": "string"}},
        "matched_terms": {"type": "array", "items": {"type": "string"}},
        "gaps": {"type": "array", "items": {"type": "string"}},
        "evidence_references": {"type": "array", "items": {"type": "string"}},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "feedback_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "detail", "evidence_references"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "growth_area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "detail", "action", "evidence_references"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
        "action": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "experience_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "detail", "status", "evidence_references"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
        "status": {
          "enum": ["confirmed", "partially_confirmed", "not_confirmed", "not_assessed"]
        },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "candidate_alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vacancy_id", "title", "matched_areas", "message", "is_automatic_transfer"],
      "properties": {
        "vacancy_id": {"type": "string", "format": "uuid"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "matched_areas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"type": "string"}
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 2000},
        "is_automatic_transfer": {"const": false}
      }
    },
    "candidate_feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "source_profile_artifact_id", "headline", "summary", "strengths", "growth_areas", "experience_alignment", "alternative_vacancy", "next_steps", "limitations", "is_hiring_decision"],
      "properties": {
        "schema_version": {"const": "candidate_feedback_v1"},
        "purpose": {"const": "candidate_feedback"},
        "source_profile_artifact_id": {"type": "string", "format": "uuid"},
        "headline": {"type": "string", "minLength": 1, "maxLength": 500},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "strengths": {
          "type": "array",
          "maxItems": 6,
          "items": {"$ref": "#/$defs/feedback_point"}
        },
        "growth_areas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/growth_area"}
        },
        "experience_alignment": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/experience_alignment"}
        },
        "alternative_vacancy": {
          "oneOf": [
            {"$ref": "#/$defs/candidate_alternative"},
            {"type": "null"}
          ]
        },
        "next_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"type": "string"}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"type": "string"}
        },
        "is_hiring_decision": {"const": false}
      }
    },
    "integrity_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "observations", "is_restriction"],
      "properties": {
        "schema_version": {"const": "session_agent_output_v2"},
        "purpose": {"const": "integrity_check"},
        "is_restriction": {"const": false},
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "resume_evidence_id", "answer_evidence_id", "response_id", "explanation", "clarification_question", "confidence"],
            "properties": {
              "status": {"enum": ["consistent", "unverified_claim", "contradiction_detected", "manual_integrity_review"]},
              "resume_evidence_id": {"type": ["string", "null"]},
              "answer_evidence_id": {"type": ["string", "null"]},
              "response_id": {"type": ["string", "null"], "format": "uuid"},
              "explanation": {"type": "string", "minLength": 1},
              "clarification_question": {"type": ["string", "null"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  }
}
