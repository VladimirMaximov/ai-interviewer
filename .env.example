OPENAI_API_KEY=replace_with_your_project_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
PROCTORING_PROVIDER=disabled
HUGGINGFACE_TOKEN=replace_with_a_read_token
PROCTORING_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
PROCTORING_EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
PROCTORING_EMBEDDING_CACHE=apps/api/models/speechbrain-spkrec-ecapa
PROCTORING_MINIMUM_REFERENCE_SECONDS=20
PROCTORING_REFERENCE_SIMILARITY=0.65
PROCTORING_SPEAKER_SIMILARITY=0.55
MANAGER_BRIEF_MODEL=gpt-4.1-mini
MANAGER_BRIEF_MAX_ATTEMPTS=3
MULTI_AGENT_MODEL=gpt-4.1-mini
FOLLOW_UP_CONFIDENCE_THRESHOLD=0.65
FOLLOW_UP_MAX_PER_SESSION=2
MULTI_AGENT_API_MODE=responses
MULTI_AGENT_MAX_ATTEMPTS=3
MULTI_AGENT_TIMEOUT_SECONDS=90
STRONG_POOL_MIN_READINESS=0.25
STRONG_POOL_MIN_COVERAGE=0.50
ALTERNATIVE_VACANCY_MIN_FIT=0.25
ALTERNATIVE_MAX_GRADE_DISTANCE=1
MULTI_AGENT_PERSONALIZATION_CAP=3
INTERVIEW_ASSESSMENT_PROVIDER=openai
INTERVIEW_ASSESSMENT_MODEL=gpt-5-mini
INTERVIEW_RECRUITER_KEY=replace-with-a-local-recruiter-secret
INTERVIEW_RECRUITER_ID=recruiter
INTERVIEW_MANAGER_KEY=replace-with-a-different-local-manager-secret
INTERVIEW_MANAGER_ID=hiring-manager

# Local candidate speech stack. `whisper_cpp` is the multilingual baseline;
# set `gigaam3` after installing the API's `local-speech` extra to use GigaAM long-form ASR
# v3 for Russian transcription. Silero is local and the browser is a fallback.
TRANSCRIPTION_PROVIDER=gigaam3
GIGAAM_MODEL=v3_e2e_rnnt
# Required for GigaAM long-form VAD after accepting pyannote/segmentation-3.0.
# HF_TOKEN=hf_your_read_token
QUESTION_SPEECH_PROVIDER=browser
SILERO_VOICE=aidar
# Optional local interpreter with torch; containers use their own Python.
# SILERO_PYTHON=apps/api/.venv-tts/bin/python
# Set QUESTION_SPEECH_PROVIDER=xtts after launching apps/api/scripts/xtts_worker.py
XTTS_ENDPOINT=http://127.0.0.1:8001
XTTS_VOICE=Claribel Dervla

# Durable local work queues and runtime presenter. Secrets belong only in the
# deployment environment, never in this file or source control.
REDIS_URL=redis://localhost:6379/0
S3_PUBLIC_ENDPOINT_URL=http://localhost:9002
CELERY_CPU_QUEUE=interview-cpu
CELERY_GPU_QUEUE=interview-presenter-gpu
PUBLIC_BASE_URL=http://localhost:5173
PRESENTER_ENABLED=false
PRESENTER_POLL_TIMEOUT_SECONDS=12
PRESENTER_MAX_ATTEMPTS=3
PRESENTER_PORTRAIT_PATH=apps/api/assets/avatar/interviewer-cutout.png
PRESENTER_MUSETALK_ROOT=/opt/MuseTalk
PRESENTER_MODEL_VERSION=musetalk-v1.5
